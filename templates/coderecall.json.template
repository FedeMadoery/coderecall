{
  "indexPath": ".coderecall",
  "extensions": [".ts", ".tsx", ".js", ".jsx"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.git/**",
    "**/coverage/**",
    "**/.coderecall/**"
  ],
  "embeddingModel": "Snowflake/snowflake-arctic-embed-s",
  "staleAfterDays": 14,
  "veryStaleAfterDays": 30
}
